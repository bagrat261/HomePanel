FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PLAYWRIGHT_BROWSERS_PATH=/opt/chromium
WORKDIR /app
COPY pyproject.toml README.md ./
COPY homepanel ./homepanel
COPY configuration ./configuration
RUN pip install --no-cache-dir '.[renderer]' && python -m playwright install --with-deps chromium && useradd --uid 10001 --create-home panel
USER panel
EXPOSE 8090
CMD ["uvicorn", "homepanel.app:app", "--host", "0.0.0.0", "--port", "8090", "--no-proxy-headers", "--workers", "1"]
